{
   version: 2,
  cleanUrls: true,
  headers: [
    {
      source: /assets/ ,
       headers: [
        {
          key: Cache-Control,
          value: public max-age=31536000 immutable
        }
      ]
    },
    {
      source: /assets/song.mp3,
      headers: [
        {
          key: Content-Type,
          value: audio/mpeg
        },
        {
          key: Accept-Ranges,
          value: bytes
        }
      ]
    }
  ],
  routes: [
    {
      src: /assets/ ,
       dest: /assets/
    },
    {
      src: /styles.css,
      dest: /styles.css
    },
    {
      src: /script.js,
      dest: /script.js
    },
    {
      src: / ,
       dest: /index.html
    }
  ]
}
